/*
 * cfCNV - benchmarking copy-number callers on low-pass cell-free DNA WGS
 * https://github.com/FPalizban/cfCNV
 */

manifest {
    name            = 'FPalizban/cfCNV'
    author          = 'Fahimeh Palizban'
    homePage        = 'https://github.com/FPalizban/cfCNV'
    description     = 'Benchmark and workflow for CNV/CNA calling in cell-free DNA whole-genome sequencing'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

params {
    // ---------------- what to run ----------------
    mode            = 'call'          // call | simulate | mix | score
    input           = null            // samplesheet CSV (see assets/samplesheet_example.csv)
    outdir          = 'results'

    // ---------------- reference ----------------
    genome          = 'GRCh38'        // GRCh37 | GRCh38 (controls QDNAseq/ichorCNA/Fragle annotation sets)
    fasta           = null            // reference FASTA used for the BAMs (.fai next to it)
    blacklist       = null            // optional BED (Spectre --blacklist; GRCh38 runs in the paper)

    // ---------------- callers and primary settings (paper, real-data configuration) ----------------
    callers         = 'qdnaseq,ichorcna,bicseq2,cnvkit,spectre,cnvmeann,dudeml,lyceum'
    tf_methods      = 'ichorcna,ace,fragle'
    qdnaseq_bins_kb = '100'           // comma list allowed, e.g. '50,100'
    ichor_window_kb = 1000
    ichor_modes     = 'lowTF'         // lowTF and/or default (tumour defaults)
    cnvkit_bin      = 30000
    cnvkit_normals  = null            // optional CSV/glob of normal BAMs -> pooled reference (flat reference otherwise)
    spectre_bin     = 100000
    bicseq2_bin     = 10000
    bicseq2_lambda  = 2
    bicseq2_readlen = 101             // read length of the mappability track
    bicseq2_container = null          // your own BIC-seq2 image (.sif or docker tag); cfCNV does not distribute one
    bicseq2_resources = null          // folder with reference/<chr>.fa and mappability/<prefix>/<prefix>.<chr>.txt
    bicseq2_map_prefix = null         // e.g. human_g1k_v37.101mer ; if resources are null they are built (slow, ~2 days)
    bicseq2_log2_threshold = 0.2      // |log2| threshold used to turn BIC-seq2 segments into calls
    // machine-learning callers (Simulation 1 primary settings)
    cnvmeann_bin    = 500000
    dudeml_bin      = 1000000
    ml_models       = null            // folder with CNV-MEANN/ and dudeML/ models (from a --mode simulate run)

    // ---------------- depth robustness ----------------
    downsample      = ''              // e.g. '1,0.1'  -> also run every caller at 1x and 0.1x
    genome_size_bp  = null            // autosomal size for depth estimation (default from FASTA)

    // ---------------- consensus / annotation ----------------
    consensus_window = 1000000
    consensus_min    = 3              // >= N callers agreeing on gain/loss in a window
    annotation_refs  = null           // folder from bin/get_annotation_refs.sh (gnomAD-SV, segdups, OncoKB, TCGA)
    liftover_chain   = null           // hg38ToHg19.over.chain.gz: annotation of GRCh38 calls, LYCEUM on GRCh37 BAMs (downloaded from UCSC if not given)

    // ---------------- simulation 1 (spike-in events) ----------------
    sim_replicates   = 5
    sim_depths       = '0.1,0.25,0.5,1'
    sim_seed         = 42
    truth            = null           // optional pre-made truth BED(s); default: generated per replicate

    // ---------------- simulation 2 (tumour-normal mixtures) ----------------
    tumour_bam       = null
    normal_bam       = null
    tumour_depth     = null           // measured depth of tumour pool (x)
    normal_depth     = null           // measured depth of normal pool (x)
    mix_fractions    = '0,0.01,0.02,0.05,0.1,0.2,0.3'
    mix_depths       = '0.1,0.25,0.5,1'

    // ---------------- score mode ----------------
    calls            = null           // harmonised calls TSV or BED (chrom start end type)
    score_overlap    = 0.5            // reciprocal overlap for an event match

    // ---------------- resources ----------------
    max_cpus         = 8
    max_memory       = '96.GB'
    max_time         = '48.h'
    container_tag    = '1.0.0'
    container_registry = 'ghcr.io/fpalizban'
    publish_mode     = 'copy'
    publish_bams     = false          // also save simulated / down-sampled BAMs (large)
}

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
    }
    slurm {
        process.executor       = 'slurm'
        executor.queueSize     = 100
        executor.submitRateLimit = '20/1min'
    }
    chop {
        includeConfig 'conf/chop.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true
           fields = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,rchar,wchar' }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
