// Resources per process. Values follow the peak memory and wall time recorded in the paper's
// Slurm accounting (QDNAseq needed 96 GB on ~12x BAMs; most callers < 1 GB at <= 1x).

process {
    cpus   = 1
    memory = '4.GB'
    time   = '4.h'
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'small'  { cpus = 1; memory = { 4.GB  * task.attempt }; time = { 2.h  * task.attempt } }
    withLabel: 'medium' { cpus = 4; memory = { 16.GB * task.attempt }; time = { 8.h  * task.attempt } }
    withLabel: 'large'  { cpus = 4; memory = { 32.GB * task.attempt }; time = { 24.h * task.attempt } }

    withName: 'QDNASEQ'           { cpus = 4; memory = { 24.GB * task.attempt * task.attempt }; time = { 8.h * task.attempt } }
    withName: 'BICSEQ2_NORMSEG'   { cpus = 2; memory = { 16.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: 'BICSEQ2_RESOURCES' { cpus = 8; memory = 64.GB; time = 72.h; maxRetries = 0 }
    withName: 'FRAGLE'            { cpus = 8; memory = { 32.GB * task.attempt }; time = { 8.h * task.attempt } }

    // ichorCNA downloads chromosome information from UCSC on first use; keep concurrency modest
    withName: 'ICHORCNA'          { maxForks = 10; errorStrategy = 'retry'; maxRetries = 3 }
}

process {
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time ]
}
