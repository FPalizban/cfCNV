// Example institutional profile (CHOP Research HPC, Slurm + Singularity 4.4.1).
// Copy and edit for your own cluster.

process {
    executor = 'slurm'
    beforeScript = 'module load singularity/4.4.1 2>/dev/null || true'
}
executor {
    queueSize       = 100
    submitRateLimit = '20/1min'
}
singularity {
    enabled    = true
    autoMounts = true
    // images are downloaded once and reused; put this on a large shared disk
    cacheDir   = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: System.getenv('HOME') + '/.singularity_cache'}"
}
docker.enabled = false

// BIC-seq2: use the exact image the paper's runs used (remove these lines to use the public image instead)
process {
    withName: 'BICSEQ2_.*' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfCNV_project/06_tools/containers/bicseq2_20210625.sif' }
}
params {
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '72.h'
}
process.resourceLimits = [ cpus: 16, memory: 128.GB, time: 72.h ]
