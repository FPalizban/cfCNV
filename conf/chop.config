// Example institutional profile (CHOP Research HPC, Slurm + Singularity 4.4.1).
// Everything stays inside the user's own project folder: ready-made .sif files are used (no image
// unpacking on the cluster), temporary files and the container "home" are the task's own work folder.
// Copy and edit for your own cluster.

params {
    sif_dir           = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif'
    // BIC-seq2: the image used for the paper's runs (cfCNV does not distribute a BIC-seq2 image)
    bicseq2_container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfCNV_project/06_tools/containers/bicseq2_20210625.sif'
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '72.h'
}
process {
    // ready-made images in your own folder (assets/hpc/pull_sif.sh); BIC-seq2: the paper's own image
    withLabel: 'cfcnv_r' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-r-1.0.0.sif' }
    withLabel: 'cfcnv_cnvkit' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-cnvkit-1.0.0.sif' }
    withLabel: 'cfcnv_spectre' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-spectre-1.0.0.sif' }
    withLabel: 'cfcnv_fragle' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-fragle-1.0.0.sif' }
    withLabel: 'cfcnv_tools' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-tools-1.0.0.sif' }
    withLabel: 'cfcnv_ml' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-ml-1.0.0.sif' }
    withLabel: 'cfcnv_lyceum' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif/cfcnv-lyceum-1.0.0.sif' }
    withLabel: 'cfcnv_bicseq2' { container = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfCNV_project/06_tools/containers/bicseq2_20210625.sif' }
    executor     = 'slurm'
    beforeScript = 'module load singularity/4.4.1 2>/dev/null || true; mkdir -p tmp; export TMPDIR=$PWD/tmp'
}
process.resourceLimits = [ cpus: 16, memory: 128.GB, time: 72.h ]
executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
}
singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--home $PWD'          // tools that write to $HOME write into the task folder
    cacheDir   = '/mnt/isilon/cag_inf_op/palizbanf/cfCNV/cfcnv_run/sif'
}
docker.enabled = false
