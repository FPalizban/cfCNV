// One container per tool. With --sif_dir, ready-made Singularity files <sif_dir>/cfcnv-<name>-<tag>.sif are used
// (downloaded with assets/hpc/pull_sif.sh); otherwise the Docker images are pulled from ghcr.io.
// Images are built from containers/<name>/Dockerfile by the GitHub Action
// .github/workflows/containers.yml and pushed to the GitHub Container Registry (ghcr.io).
// To use a local image instead (e.g. the exact BIC-seq2 .sif used for the paper), override in a
// custom config:  process { withName: 'BICSEQ2_.*' { container = '/path/to/bicseq2_20210625.sif' } }

process {
    withLabel: 'cfcnv_r'       { container = params.sif_dir ? "${params.sif_dir}/cfcnv-r-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-r:${params.container_tag}" }
    withLabel: 'cfcnv_cnvkit'  { container = params.sif_dir ? "${params.sif_dir}/cfcnv-cnvkit-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-cnvkit:${params.container_tag}" }
    withLabel: 'cfcnv_bicseq2' { container = params.bicseq2_container }      // not distributed: see assets/hpc/README_bicseq2.md
    withLabel: 'cfcnv_spectre' { container = params.sif_dir ? "${params.sif_dir}/cfcnv-spectre-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-spectre:${params.container_tag}" }
    withLabel: 'cfcnv_fragle'  { container = params.sif_dir ? "${params.sif_dir}/cfcnv-fragle-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-fragle:${params.container_tag}" }
    withLabel: 'cfcnv_tools'   { container = params.sif_dir ? "${params.sif_dir}/cfcnv-tools-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-tools:${params.container_tag}" }
    withLabel: 'cfcnv_ml'      { container = params.sif_dir ? "${params.sif_dir}/cfcnv-ml-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-ml:${params.container_tag}" }
    withLabel: 'cfcnv_lyceum'  { container = params.sif_dir ? "${params.sif_dir}/cfcnv-lyceum-${params.container_tag}.sif" : "${params.container_registry}/cfcnv-lyceum:${params.container_tag}" }
}
