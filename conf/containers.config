// One container per tool. Images are built from containers/<name>/Dockerfile by the GitHub Action
// .github/workflows/containers.yml and pushed to the GitHub Container Registry (ghcr.io).
// To use a local image instead (e.g. the exact BIC-seq2 .sif used for the paper), override in a
// custom config:  process { withName: 'BICSEQ2_.*' { container = '/path/to/bicseq2_20210625.sif' } }

process {
    withLabel: 'cfcnv_r'       { container = "${params.container_registry}/cfcnv-r:${params.container_tag}" }
    withLabel: 'cfcnv_cnvkit'  { container = "${params.container_registry}/cfcnv-cnvkit:${params.container_tag}" }
    withLabel: 'cfcnv_bicseq2' { container = params.bicseq2_container }      // not distributed: see assets/hpc/README_bicseq2.md
    withLabel: 'cfcnv_spectre' { container = "${params.container_registry}/cfcnv-spectre:${params.container_tag}" }
    withLabel: 'cfcnv_fragle'  { container = "${params.container_registry}/cfcnv-fragle:${params.container_tag}" }
    withLabel: 'cfcnv_tools'   { container = "${params.container_registry}/cfcnv-tools:${params.container_tag}" }
    withLabel: 'cfcnv_ml'      { container = "${params.container_registry}/cfcnv-ml:${params.container_tag}" }
    withLabel: 'cfcnv_lyceum'  { container = "${params.container_registry}/cfcnv-lyceum:${params.container_tag}" }
}
