// One container per tool. Images are built from containers/<name>/Dockerfile by the GitHub Action
// .github/workflows/containers.yml and pushed to the GitHub Container Registry (ghcr.io).
// To use a local image instead (e.g. the exact BIC-seq2 .sif used for the paper), override in a
// custom config:  process { withName: 'BICSEQ2_.*' { container = '/path/to/bicseq2_20210625.sif' } }

def reg = params.container_registry
def tag = params.container_tag

process {
    withLabel: 'cfcnv_r'       { container = "${reg}/cfcnv-r:${tag}" }
    withLabel: 'cfcnv_cnvkit'  { container = "${reg}/cfcnv-cnvkit:${tag}" }
    withLabel: 'cfcnv_bicseq2' { container = "${reg}/cfcnv-bicseq2:${tag}" }
    withLabel: 'cfcnv_spectre' { container = "${reg}/cfcnv-spectre:${tag}" }
    withLabel: 'cfcnv_fragle'  { container = "${reg}/cfcnv-fragle:${tag}" }
    withLabel: 'cfcnv_tools'   { container = "${reg}/cfcnv-tools:${tag}" }
    withLabel: 'cfcnv_ml'      { container = "${reg}/cfcnv-ml:${tag}" }
    withLabel: 'cfcnv_lyceum'  { container = "${reg}/cfcnv-lyceum:${tag}" }
}
