// Minimal settings for a quick check of the wiring.
//   nextflow run main.nf -profile test -stub          (no containers, seconds; checks the workflow logic)
//   nextflow run main.nf -profile test,singularity    (real tools on the tiny test BAMs in assets/test)

params {
    input            = "${projectDir}/assets/test/samplesheet_test.csv"
    fasta            = "${projectDir}/assets/test/ref.fa"
    genome           = 'GRCh37'
    callers          = 'qdnaseq,ichorcna,bicseq2,cnvkit,spectre'
    tf_methods       = 'ichorcna,ace,fragle'
    downsample       = '0.5'
    bicseq2_resources  = "${projectDir}/assets/test/bicseq2"
    bicseq2_map_prefix = 'test.101mer'
    max_cpus         = 1
    max_memory       = '2.GB'
    max_time         = '2.h'
    outdir           = 'results_test'
}
process.resourceLimits = [ cpus: 1, memory: 2.GB, time: 2.h ]
