// Where results are written (inside --outdir)
process {
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: params.publish_mode,
                   saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]

    withName: 'QDNASEQ|ACE'         { publishDir = [ path: { "${params.outdir}/callers/QDNAseq_ACE/${meta.id}" },  mode: params.publish_mode ] }
    withName: 'ICHORCNA'            { publishDir = [ path: { "${params.outdir}/callers/ichorCNA/${meta.id}" },     mode: params.publish_mode ] }
    withName: 'CNVKIT'              { publishDir = [ path: { "${params.outdir}/callers/CNVkit/${meta.id}" },       mode: params.publish_mode ] }
    withName: 'CNVKIT_REFERENCE'    { publishDir = [ path: { "${params.outdir}/callers/CNVkit" },                  mode: params.publish_mode ] }
    withName: 'SPECTRE'             { publishDir = [ path: { "${params.outdir}/callers/Spectre/${meta.id}" },      mode: params.publish_mode ] }
    withName: 'MOSDEPTH_BINS'       { publishDir = [ enabled: false ] }
    withName: 'BICSEQ2_UNIQUE'      { publishDir = [ enabled: false ] }
    withName: 'BICSEQ2_NORMSEG'     { publishDir = [ path: { "${params.outdir}/callers/BIC-seq2/${meta.id}" },     mode: params.publish_mode ] }
    withName: 'FRAGLE'              { publishDir = [ path: { "${params.outdir}/callers/Fragle/${meta.id}" },       mode: params.publish_mode ] }
    withName: 'COLLECT_CALLS|CONSENSUS|SCORE' { publishDir = [ path: { "${params.outdir}/summary" },               mode: params.publish_mode ] }
    withName: 'ANNOTATE'            { publishDir = [ path: { "${params.outdir}/summary" },                         mode: params.publish_mode ] }
    withName: 'MAKE_TRUTH'          { publishDir = [ path: { "${params.outdir}/simulation/truth" },                mode: params.publish_mode ] }
    withName: 'DOWNSAMPLE|SPIKE_CNVS|MIX_TUMOUR_NORMAL' {
        publishDir = [ path: { "${params.outdir}/bams" }, mode: params.publish_mode, enabled: params.publish_bams,
                       saveAs: { fn -> fn.endsWith('.depth.txt') || params.publish_bams ? fn : null } ]
    }
}
